# EmailJS free plan — create keys at https://www.emailjs.com/
# 1. Add an Email Service (Gmail recommended)
# 2. Create a template with variables: {{from_name}}, {{from_email}}, {{reply_to}}, {{message}}
# 3. Copy Service ID, Template ID, and Public Key (Account → API Keys)

REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key
